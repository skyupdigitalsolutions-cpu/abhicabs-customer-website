# ─────────────────────────────────────────────────────────────────────────────
# ABHI CABS — Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Point this at your running backend. The frontend (Vike) runs on port 3000,
# so your backend must be on a DIFFERENT port. Check your backend terminal
# output — it usually prints something like "Server listening on port 4000".
#
# Common backend ports: 4000, 5000, 8000, 8080
# Change the number below to match YOUR backend, then restart `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_BASE_URL=https://abhicabsbackend-production.up.railway.app/api/v1

# Master mock switch:
#   false = use the real backend only
#   true  = force mock mode, never call the backend
VITE_USE_MOCK=false

# Fully connected mode: every request either succeeds with real backend data
# or shows a real error — no silent demo-data masking of a missing/broken
# endpoint. Keep this false.
VITE_MOCK_FALLBACK=false

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — real payment popup
# ─────────────────────────────────────────────────────────────────────────────
# Your PUBLIC key ID only — safe to expose in frontend code. Get this from
# the Razorpay Dashboard → Settings → API Keys. Use the rzp_test_... key
# while testing, switch to rzp_live_... only when ready to take real money.
# Leave blank while VITE_USE_MOCK=true — payment popup is skipped in mock mode.
VITE_RAZORPAY_KEY_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps — real embedded map on the Live Tracking page
# ─────────────────────────────────────────────────────────────────────────────
# Get one from https://console.cloud.google.com/google/maps-apis (enable
# "Maps JavaScript API"). Leave blank and the tracking page shows a clear
# message instead of a broken/blank map.
VITE_GOOGLE_MAPS_API_KEY= AIzaSyA9wdnqO5ADt5WaWpbQlBytuJGLL__ur24

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging — web push notifications
# ─────────────────────────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → General → "Your apps" → Web app
# (create one if you haven't). Leave all blank to skip push entirely — the
# site works completely normally without it, push is just not offered.
VITE_FIREBASE_API_KEY= AIzaSyBAd2Pz7bu5yacgJcGLDWYWNZYZwsSWWIc
VITE_FIREBASE_AUTH_DOMAIN= abhicabs-3c127.firebaseapp.com
VITE_FIREBASE_PROJECT_ID= abhicabs-3c127
VITE_FIREBASE_MESSAGING_SENDER_ID= 191880571806
VITE_FIREBASE_APP_ID= 1:191880571806:web:bca747cf7b2be771a7048f

# Firebase Console → Project Settings → Cloud Messaging → Web Push
# certificates → generate a key pair. This one is safe to expose in
# frontend code (it authorizes THIS site to request a push subscription,
# same trust level as the Razorpay key ID above).
VITE_FIREBASE_VAPID_KEY= BHxItnSCGaEF8fhfEFWoxIoVeK0cflgrqYj7xQXc4XijeYFt1Pmgg7MyXBpPBfzhRe5fO482XavUlm-jygfXAUw
